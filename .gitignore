dsh-redteam-mode-main/
/1

# 外部参考，不是本插件
choirboy-prompt/
/choirboy-prompt/
_archive/
频道推广手册/

# 提示词原文只在本地维护，任何形式都不进仓库
lib/default-prompt-inject.md
lib/default-prompt-inject.zh.md
lib/default-prompt-inject.en.md
default-prompt-inject.md

# 本机官方安装包、解包目录、拆出的压缩包
/deepseek-harness-*.exe
/official-harness-unpacked/
/official-harness-payload.7z
*.asar
*.asar.bak
*.bak

# 拆分对照黄金基线（临时，不进仓库）
/.tmp-split/

# 覆盖率产物（npm run test:full 生成，不进仓库）
/.tmp-coverage/

# 临时实验目录（探测脚本、一次性改写脚本，不进仓库）
/.tmp-exp/

# 沙盒副本（scripts/sandbox-apply.mjs 复制出来的宿主副本，6.4MB，每次重建）
/.tmp-sandbox/

# 宿主升级预演（scripts/host-preview.mjs 装进去的完整 rc 树，1.4GB，每次重装）
/.tmp-preview/

# 真宿主重打前的自建快照（119 个目标文件的 sha256 副本，不依赖 .dshpurge.bak）
/.tmp-realhost-snapshot/

# 纯净上游树（npm 装出来的 rc.N，用于当独立基线做两版对拍，每个 1.5GB）
/.tmp-tree/
