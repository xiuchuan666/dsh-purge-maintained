{
  "name": "dsh-purge",
  "version": "1.1.94",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "author": "dsh-purge maintainers",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/**/*.bak",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"scripts/test-*.mjs\"",
    "test:full": "node scripts/coverage-suite.mjs",
    "test:baseline": "node scripts/check-coverage-baseline.mjs --update",
    "check": "npm run check:syntax && npm run check:metadata && npm run check:eol && npm run check:client && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:eol": "node scripts/check-eol.mjs",
    "check:client": "node scripts/check-client.mjs",
    "host:status": "node scripts/host-baseline.mjs",
    "host:capture": "node scripts/host-baseline.mjs --capture",
    "host:sandbox": "node scripts/sandbox-apply.mjs",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiuchuan666/dsh-purge-maintained.git"
  },
  "homepage": "https://github.com/xiuchuan666/dsh-purge-maintained#readme",
  "bugs": {
    "url": "https://github.com/xiuchuan666/dsh-purge-maintained/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/xiuchuan666/dsh-purge-maintained/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/xiuchuan666/dsh-purge-maintained/zip/refs/heads/main",
      "git": "https://github.com/xiuchuan666/dsh-purge-maintained.git"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "dshTarget": "0.2.2-rc.1",
  "dshTargets": [
    "0.2.2-rc.1",
    "0.2.1-rc.5",
    "0.2.1-rc.2"
  ]
}
